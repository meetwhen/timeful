# Shared Caddy edge configuration. This file is used only by the edge Compose stacks.

# Production
CADDY_PRODUCTION_DOMAIN=timeful.fun
CADDY_PRODUCTION_WWW_DOMAIN=www.timeful.fun
CADDY_PRODUCTION_UPSTREAM=production-server:3005

# Staging
CADDY_STAGING_DOMAIN=staging.timeful.fun
CADDY_STAGING_WWW_DOMAIN=www.staging.timeful.fun
CADDY_STAGING_UPSTREAM=staging-server:3004

# Inbound mail (Stalwart)
CADDY_MAIL_DOMAIN=mail.timeful.fun
CADDY_MAIL_UPSTREAM=http://stalwart:8080
