# Root test environment for isolated browser and Mongo-backed tests.

# Frontend tooling
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=4174
VITE_API_PROXY_TARGET=http://127.0.0.1:3005
VITE_APP_ENV=development
VITE_ENABLE_SIGN_IN=true
VITE_ENABLE_FREEMIUM=false
VITE_ENABLE_RICH_LANDING=true
VITE_ENABLE_THIRD_PARTY_SHELL=false
VITE_ENABLE_PRIVACY_POLICY=true
VITE_FEEDBACK_URL=https://github.com/deemp/timeful/issues
VITE_SUPPORT_EMAIL=contact@timeful.fun
VITE_GITHUB_REPO_URL=https://github.com/deemp/timeful

# Backend runtime values. Test is an execution context, so the application remains
# in development mode while using an isolated database and server port.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:4174
MONGODB_URI=mongodb://mongo-test:27017
MONGODB_DATABASE=timeful-test
SESSION_SECRET=01234567890123456789012345678901
GIN_MODE=debug

# Keep Mongo data after test runs for inspection. Set false to remove its volume.
TEST_MONGO_PERSIST=true
