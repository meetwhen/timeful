{"nodes": [{"id": "server_docs_postgres_anonymous_event_compatibility_postgres_events", "label": "postgres_events Table", "file_type": "concept", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These tables own only new anonymous timed and dates-only polls; MongoDB remains authoritative for legacy events, authenticated creation, groups, and dashboard loading."}, {"id": "server_docs_postgres_anonymous_event_compatibility_postgres_event_responses", "label": "postgres_event_responses Table", "file_type": "concept", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "server_docs_postgres_anonymous_event_compatibility_short_id", "label": "Short ID (Crockford Base32)", "file_type": "rationale", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgres_events.id and postgres_event_responses.id are internal UUIDv7 identities; API handlers expose only the eight-character Crockford Base32 short_id."}, {"id": "server_docs_postgres_anonymous_event_compatibility_jsonb_payloads", "label": "JSONB Payload Strategy", "file_type": "concept", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgres_events.payload holds all remaining event state; JSON arrays keep input order and duplicates; instants are normalized to millisecond precision before writing JSONB and before API output."}, {"id": "server_docs_postgres_anonymous_event_compatibility_compatibility_rules", "label": "Compatibility Rules (absent vs null vs empty)", "file_type": "rationale", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repository must distinguish absent fields, JSON null, empty arrays/maps, and zero scalars to preserve Mongo BSON omitempty behavior."}, {"id": "server_docs_postgres_anonymous_event_compatibility_transactions", "label": "Transaction Strategy", "file_type": "rationale", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transactions deliberately prevent duplicate response races and response-count drift; reproducing internal Mongo failure modes is not required for API compatibility."}, {"id": "server_docs_postgres_anonymous_event_compatibility_guest_edit_token", "label": "guest_edit_token Raw Storage", "file_type": "rationale", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "guest_edit_token intentionally stores the raw token in phase one because open, tokenless mutation must return the stored credential; token hashing is deferred until the API and frontend ownership contract change together."}, {"id": "server_respondents_identity_normalizeguestname", "label": "respondents.NormalizeGuestName", "file_type": "code", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "server_docs_postgres_anonymous_event_compatibility_postgres_events", "target": "server_docs_postgres_anonymous_event_compatibility_short_id", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "sour