{"nodes": [{"id": "docs_design_architecture_adr_adr_009", "label": "ADR-009: Frontend Guest Response Ownership Semantics", "file_type": "document", "source_file": "docs/design/architecture/adr/ADR-009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guest response ownership must stay consistent across event loads, mutations, and browser-local storage without views reconstructing identity or transport behavior."}, {"id": "docs_design_architecture_adr_adr_009_guest_id", "label": "Legacy guestId Ownership Identifier", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opaque browser-local guest-response ownership identifier; stored display name is the legacy fallback when no guestId exists; neither equals the proposed Event Visitor Identity."}, {"id": "docs_design_architecture_adr_adr_009_event_visitor_identity", "label": "Event Visitor Identity", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed identity that owns responses independently of display names and may associate with a Platform Identity for recovery; must be introduced at an explicit boundary."}, {"id": "docs_design_architecture_adr_adr_009_evcc", "label": "Event Visitor Control Credential", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Private PostgreSQL authority value for an event visitor; separate from legacy guest storage and from the public Event Visitor Identity."}, {"id": "docs_design_architecture_adr_adr_009_granted_evcc", "label": "Granted Event Visitor Control Credential", "f