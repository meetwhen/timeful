{"nodes": [{"id": "docs_design_architecture_adr_adr_010", "label": "ADR-010: Source-Confirmed Access Transfers", "file_type": "document", "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visitors need cross-browser continuation without treating a copied URL as a credential or exposing respondents in Blind Availability Mode; matching-code source confirmation prevents link interception, and bearer-link, email-only, and direct ownership-transfer options were rejected to preserve source authority."}, {"id": "docs_design_architecture_adr_adr_010_access_transfer", "label": "Access Transfer", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pending transfer created from a copied link, expiring five minutes after creation; opening the link alone grants no authority and approval consumes the pending transfer."}, {"id": "docs_design_architecture_adr_adr_010_matching_code_approval", "label": "Matching-Code Approval", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target browser displays a matching code the source browser must approve within the five-minute window, preventing the first opener of a copied link from binding the transfer."}, {"id": "docs_design_architecture_adr_adr_010_platform_visitor_identity", "label": "Platform Visitor Identity", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authenticated identity that receives a normal session on the target browser after approval and may later be associated with a source Event Visitor Identity for durable recovery."}, {"id": "docs_design_architecture_adr_adr_010_blind_availability_mode", "label": "Blind Availability Mode", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_design_architecture_adr_adr_010_fr_082", "label": "FR-082", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_design_architecture_adr_adr_010", "target": "docs_design_architecture_adr_adr_010_access_transfer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_010", "target": "docs_design_architecture_adr_adr_010_matching_code_approval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_010", "target": "docs_design_architecture_adr_adr_010_platform_visitor_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_010", "target": "docs_design_architecture_adr_adr_010_blind_availability_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-010.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_010", "target": "docs_design_architecture_adr_adr_009_granted_evcc", "relation": "referen