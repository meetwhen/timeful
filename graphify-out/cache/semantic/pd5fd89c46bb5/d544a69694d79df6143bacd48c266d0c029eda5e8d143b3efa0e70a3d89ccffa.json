{"nodes": [{"id": "server_docs_postgres_anonymous_event_compatibility_md_pg_anonymous_event_contract", "label": "PostgreSQL anonymous event compatibility contract", "file_type": "concept", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "server_docs_postgres_anonymous_event_compatibility_md_dual_storage_boundary", "label": "Mongo-authoritative / PostgreSQL-anonymous boundary", "file_type": "rationale", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"rationale": "MongoDB remains authoritative for legacy events, authenticated creation, groups, and dashboard loading, while PostgreSQL owns only new anonymous timed and dates-only polls."}}, {"id": "server_docs_postgres_anonymous_event_compatibility_md_postgres_events_table", "label": "postgres_events table", "file_type": "concept", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "server_docs_postgres_anonymous_event_compatibility_md_postgres_event_responses_table", "label": "postgres_event_responses table", "file_type": "concept", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "server_docs_postgres_anonymous_event_compatibility_md_short_id", "label": "short_id (Crockford Base32)", "file_type": "concept", "source_file": "server/docs/postgres-anonymous-event-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "server_docs_postgres_anonymous_event_compatibility_md_uuidv7_identity", "label": "Internal UUIDv7 i