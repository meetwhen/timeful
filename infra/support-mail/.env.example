# Copy to .env next to compose.yaml and fill in values.

# Public URL clients use to reach the mail HTTP services (admin UI, JMAP,
# autoconfig). Must match what Caddy serves for CADDY_MAIL_DOMAIN.
STALWART_PUBLIC_URL=https://mail.timeful.fun

# Hostname the server answers to; used for the SMTP greeting, certificates
# and as the default HTTP base URL.
MAIL_DOMAIN=mail.timeful.fun

# Bootstrap/recovery admin. Remove from .env after the permanent wizard
# administrator is verified and this variable is dropped from compose.
STALWART_RECOVERY_ADMIN=admin:CHANGE_ME_REPLACE_AFTER_FIRST_LOGIN

# Set to 1 only while provisioning accounts over the recovery HTTP listener
# (bootstrap mode / recovery mode); unset for normal operation.
STALWART_RECOVERY_MODE=

# Host the admin HTTP listener binds to on the VM. 127.0.0.1 keeps the
# wizard and management UI off the public internet; Caddy reaches it
# locally. Use 0.0.0.0 only if Caddy runs on a different host.
STALWART_ADMIN_BIND_HOST=127.0.0.1

# Caddy data directory on the VM (where its Let's Encrypt certificates
# live). Used by scripts/sync-certs.sh.
CADDY_DATA_DIR=/var/lib/caddy

# Credentials for the CLI container used by scripts/sync-certs.sh to
# trigger cert reloads. STALWART_USER is the administrator account created
# by the setup wizard (e.g. admin@timeful.fun).
STALWART_URL=https://mail.timeful.fun
STALWART_USER=admin@timeful.fun
STALWART_PASSWORD=CHANGE_ME_WIZARD_ADMIN_PASSWORD